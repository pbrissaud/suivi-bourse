# SuiviBourse — copy to .env and edit. Every value here is optional except
# INFLUXDB_TOKEN; the defaults shown are the ones the app uses.
#
#   cp .env.example .env      # or: make init

# ---------------------------------------------------------------------------
# Storage — the token is REQUIRED and deliberately empty here: no shared secret
# ships with the project. `make init` fills it with a freshly generated value;
# if you copied this file by hand, generate one yourself:
#
#   make token                          # or: echo "apiv3_$(openssl rand -hex 32)"
#
# It is the single source of truth — InfluxDB, Grafana's provisioned datasource
# and the app all read it from here. The stack refuses to start while it is
# empty. Avoid `$` in the value: Grafana expands $VAR inside provisioning files.
# ---------------------------------------------------------------------------
INFLUXDB_TOKEN=
INFLUXDB_DATABASE=suivi_bourse

# ---------------------------------------------------------------------------
# Deployment
# ---------------------------------------------------------------------------
# App image tag. Pin an exact version (e.g. 4.2.1) for reproducible upgrades
# and rollbacks; a bare major tracks the latest release of that major.
SB_VERSION=4
# Config directory mounted into the app. Copied from data.example/.
SB_CONFIG_DIR=./data
# Prefix for container and volume names. Change it to run two stacks side by side.
# COMPOSE_PROJECT_NAME=suivi-bourse

# ---------------------------------------------------------------------------
# Ports
# ---------------------------------------------------------------------------
# docker-compose.yaml publishes nothing on its own; docker-compose.expose.yaml
# is the overlay that maps the services onto host ports. Chaining both here is
# what makes a plain `docker compose up -d` behave as it always did. Comment
# this line out to stop publishing anything on the host — do that when a reverse
# proxy fronts the stack and reaches the services over the compose network.
# (Windows: separate the two files with `;` instead of `:`.)
COMPOSE_FILE=docker-compose.yaml:docker-compose.expose.yaml
GRAFANA_PORT=3000
INFLUXDB_PORT=8181
# Web UI / API of the app, and the port its healthcheck probes.
SB_WEB_PORT=8080
# Grafana's admin password. `admin` is the documented first-login default;
# change it before publishing port 3000 beyond localhost.
GF_ADMIN_PASSWORD=admin

# ---------------------------------------------------------------------------
# Configuration mode. Leave empty to let the app decide: an explicit `mode:` in
# settings.yaml wins, otherwise events mode is used as soon as your config
# directory holds event files. Set to `manual` or `events` to force one.
# ---------------------------------------------------------------------------
SB_CONFIG_MODE=

# ---------------------------------------------------------------------------
# Scheduling (seconds)
# ---------------------------------------------------------------------------
# Poll interval for a symbol whose market is open. Closed markets sleep to the
# next open on their own.
SB_REGULAR_INTERVAL=120
# Performance recompute (account_metrics / portfolio_totals).
SB_PERF_INTERVAL=120
# Event ingestion. With `watch: true` in settings.yaml, file changes are picked
# up immediately and this is only the safety net.
SB_INGESTION_INTERVAL=300
# Price-freshness sonde: warn when a stored price stays frozen this long while
# the live quote moves. 0 disables it.
SB_STALENESS_HORIZON=900

# Thread pool. Auto-sizing derives it from your largest same-exchange cohort;
# SB_EXECUTOR_POOL is ignored when it is on.
SB_DYNAMIC_EXECUTOR_POOL=false
SB_EXECUTOR_POOL=10

# ---------------------------------------------------------------------------
# Backfill (historical prices)
# ---------------------------------------------------------------------------
SB_BACKFILL_INTERVAL=60
SB_BACKFILL_DELAY=10
SB_BACKFILL_CHUNK_DAYS=365

# ---------------------------------------------------------------------------
# Legacy Prometheus /metrics endpoint
# ---------------------------------------------------------------------------
SB_PROMETHEUS_ENABLED=true
SB_METRICS_PORT=8081

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
