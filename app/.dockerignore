# The build context is ./app (.github/workflows/releasing.yml, docker-compose*),
# and since #659 that directory holds a front-end workspace. Without this file
# the daemon uploads ~230 MB of node_modules — and, worse, `COPY web ./web` in
# the node stage would overwrite the image's freshly installed dependencies with
# the host's, which are built for the host's platform.
web/node_modules/
web/dist/
web/.vite/

# Built by the node stage inside the image; a stale local copy must never win.
src/static/

# Python local state
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/
.coverage
htmlcov/
