# The built SPA. Vite writes it here (app/web/vite.config.ts `build.outDir`) so
# Flask resolves one path in a checkout and in the image alike; it is a build
# artefact either way and never committed. #655 decision 2 weighed the opposite
# — vendoring minified bundles into the repo — and rejected it: invisible to the
# dependency automation, hand-updated, and it would not even have removed the
# JSON endpoints.
src/static/

# Front-end workspace
web/node_modules/
web/dist/
web/.vite/

# Re-include the front's `lib/`. The repo-root .gitignore carries `lib/` from
# the Python template (line 30), which matches `app/web/src/lib/` and silently
# swallowed api.ts / format.ts / utils.ts — the build then failed only on a
# fresh checkout, because a local `docker build` reads the working tree rather
# than what git actually holds.
#
# It has to negate the **directory**: git cannot re-include a file whose parent
# directory is excluded, so `!web/src/lib/*.ts` alone would do nothing.
!web/src/lib/
