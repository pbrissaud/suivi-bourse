engine biome(1.0)
language css

// A semantic token names a meaning and points at a standard one (#1130).
CssDeclarationWithSemicolon() as $d where {
  $d <: r"\s*(--[a-z0-9-]+)\s*:([^;]*);?\s*"($name, $value),
  $d <: within CssQualifiedRule() as $rule where { $rule <: r"\s*(?::root|\.dark)\s*\{[\s\S]*" },
  $name <: not or {
    "--background",
    "--foreground",
    "--card",
    "--card-foreground",
    "--popover",
    "--popover-foreground",
    "--primary",
    "--primary-foreground",
    "--secondary",
    "--secondary-foreground",
    "--muted",
    "--muted-foreground",
    "--accent",
    "--accent-foreground",
    "--destructive",
    "--destructive-foreground",
    "--border",
    "--input",
    "--ring",
    "--chart-1",
    "--chart-2",
    "--chart-3",
    "--chart-4",
    "--chart-5",
    "--sidebar",
    "--sidebar-foreground",
    "--sidebar-primary",
    "--sidebar-primary-foreground",
    "--sidebar-accent",
    "--sidebar-accent-foreground",
    "--sidebar-border",
    "--sidebar-ring",
    "--radius",
    "--font-sans",
    "--font-serif",
    "--font-mono",
    "--letter-spacing",
    "--spacing",
    "--tracking-normal",
    "--shadow-color",
    "--shadow-opacity",
    "--shadow-blur",
    "--shadow-spread",
    "--shadow-offset-x",
    "--shadow-offset-y",
    "--shadow-2xs",
    "--shadow-xs",
    "--shadow-sm",
    "--shadow",
    "--shadow-md",
    "--shadow-lg",
    "--shadow-xl",
    "--shadow-2xl"
  },
  $value <: not r"\s*(?:var\(--(?:background|foreground|card|card-foreground|popover|popover-foreground|primary|primary-foreground|secondary|secondary-foreground|muted|muted-foreground|accent|accent-foreground|destructive|destructive-foreground|border|input|ring|chart-1|chart-2|chart-3|chart-4|chart-5|sidebar|sidebar-foreground|sidebar-primary|sidebar-primary-foreground|sidebar-accent|sidebar-accent-foreground|sidebar-border|sidebar-ring|radius|font-sans|font-serif|font-mono|letter-spacing|spacing|tracking-normal|shadow-color|shadow-opacity|shadow-blur|shadow-spread|shadow-offset-x|shadow-offset-y|shadow-2xs|shadow-xs|shadow-sm|shadow|shadow-md|shadow-lg|shadow-xl|shadow-2xl)\)|color-mix\(\s*in\s+oklch\s*,\s*var\(--(?:background|foreground|card|card-foreground|popover|popover-foreground|primary|primary-foreground|secondary|secondary-foreground|muted|muted-foreground|accent|accent-foreground|destructive|destructive-foreground|border|input|ring|chart-1|chart-2|chart-3|chart-4|chart-5|sidebar|sidebar-foreground|sidebar-primary|sidebar-primary-foreground|sidebar-accent|sidebar-accent-foreground|sidebar-border|sidebar-ring|radius|font-sans|font-serif|font-mono|letter-spacing|spacing|tracking-normal|shadow-color|shadow-opacity|shadow-blur|shadow-spread|shadow-offset-x|shadow-offset-y|shadow-2xs|shadow-xs|shadow-sm|shadow|shadow-md|shadow-lg|shadow-xl|shadow-2xl)\)(?:\s+\d+%)?\s*,\s*var\(--(?:background|foreground|card|card-foreground|popover|popover-foreground|primary|primary-foreground|secondary|secondary-foreground|muted|muted-foreground|accent|accent-foreground|destructive|destructive-foreground|border|input|ring|chart-1|chart-2|chart-3|chart-4|chart-5|sidebar|sidebar-foreground|sidebar-primary|sidebar-primary-foreground|sidebar-accent|sidebar-accent-foreground|sidebar-border|sidebar-ring|radius|font-sans|font-serif|font-mono|letter-spacing|spacing|tracking-normal|shadow-color|shadow-opacity|shadow-blur|shadow-spread|shadow-offset-x|shadow-offset-y|shadow-2xs|shadow-xs|shadow-sm|shadow|shadow-md|shadow-lg|shadow-xl|shadow-2xl)\)(?:\s+\d+%)?\s*\))\s*",
  register_diagnostic(span = $d, message = "[semantic-token-alias] A semantic token is an alias of a standard one (#1130)")
}
